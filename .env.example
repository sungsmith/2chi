# Database (로컬 Docker)
DATABASE_URL=postgresql://2chi:2chi_password@localhost:5432/2chi_db
POSTGRES_USER=2chi
POSTGRES_PASSWORD=2chi_password
POSTGRES_DB=2chi_db

# Redis (로컬 Docker)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production_refresh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=your_api_key_here

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=2chi-files
R2_PUBLIC_URL=

# App
NEXT_PUBLIC_API_URL=http://localhost:3001
PORT=3001
NODE_ENV=development
